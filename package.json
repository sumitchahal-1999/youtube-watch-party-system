{
  "name": "youtube-watch-party-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A React watch party app with an Express API and MongoDB.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "concurrently -k \"node --watch src/server.js\" \"vite --host 0.0.0.0\"",
    "build": "vite build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "vite": "^6.4.4"
  }
}
